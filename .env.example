# =====================================================================
#  Müzik botu ayarları
#  Bu dosyayı kopyalayıp adını ".env" yapın, sonra değerleri doldurun.
#  .env dosyasını KİMSEYLE paylaşmayın; içinde şifreleriniz olur.
#  Eşittir (=) işaretinin iki yanına boşluk koymayın.
#  Bir değerin içinde # işareti varsa değeri çift tırnağa alın: SIFRE="ab#cd"
# =====================================================================

# --- Discord (zorunlu) ------------------------------------------------
# Developer Portal > uygulamanız > Bot > "Reset Token" ile alınan token.
DISCORD_TOKEN=
# Developer Portal > uygulamanız > General Information > "Application ID".
DISCORD_CLIENT_ID=
# İsteğe bağlı: tek bir sunucunun kimliği. Doluysa komutlar yalnız o sunucuya
# ve ANINDA kaydedilir. Boşsa tüm sunuculara kaydedilir (birkaç dakika sürebilir).
DISCORD_GUILD_ID=

# --- Lavalink (zorunlu) -----------------------------------------------
# Kendi belirlediğiniz bir şifre. Hem bot hem Lavalink bunu kullanır.
# Örnek: uzun ve tahmin edilmesi zor bir kelime dizisi.
LAVALINK_PASSWORD=
# Bunlara normalde dokunmayın. LAVALINK_PORT hem Lavalink'in dinlediği hem botun
# bağlandığı porttur (2333 başka bir programca kullanılıyorsa değiştirin, ikisi birlikte değişir).
# Lavalink her zaman yalnızca 127.0.0.1'i dinler; LAVALINK_HOST yalnızca botun bağlanacağı adrestir.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# Lavalink'in kullanabileceği en fazla bellek (ör. 512M, 1G).
LAVALINK_JAVA_MEMORY=512M

# --- YouTube girişi (OAuth) -------------------------------------------
# İlk çalıştırmada BOŞ bırakın. Lavalink giriş kodu gösterir; YAN bir Google
# hesabıyla giriş yaptıktan sonra "npm run youtube-token" bu satırı kendisi doldurur.
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- Spotify (isteğe bağlı) -------------------------------------------
# developer.spotify.com/dashboard üzerinden oluşturduğunuz uygulamanın bilgileri.
# Boş bırakılırsa Spotify bağlantıları çalışmaz, YouTube çalışmaya devam eder.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Müzik davranışı (isteğe bağlı) -----------------------------------
# Yeni oynatıcıların başlangıç ses seviyesi (1-150, 100 = normal).
DEFAULT_VOLUME=80
# true: bot ses kanalından kendiliğinden hiç ayrılmaz (24/7). false: ayrılır.
TWENTY_FOUR_SEVEN=false
# Ses kanalında kimse kalmayınca kaç saniye sonra ayrılsın.
LEAVE_WHEN_EMPTY_SECONDS=60
# Kuyruk bitince kaç saniye sonra ayrılsın.
LEAVE_AFTER_QUEUE_END_SECONDS=120
# Şarkı adıyla arama nerede yapılsın: ytmsearch (YouTube Music), ytsearch (YouTube), scsearch (SoundCloud).
SEARCH_SOURCE=ytmsearch
# Sesli komutun konuşma tanıma modeli (bileşen Araçlar > "Sesli komut bileşenini kur" ile kurulur):
# otomatik (GPU ve 3 GB boş ekran belleği varsa turbo, yoksa small), turbo (GPU, daha doğru), small (CPU, daha hafif).
SESLI_KOMUT_MODEL=otomatik
# Yalnız sorun ayıklamak için: true iken uyandırma sözü bulunan sesli komut cümlelerinin metni kayda yazılır
# ve masaüstü uygulaması kayıtları diske kaydeder (sohbet cümlelerinin metni yazılmaz).
# Kendi testinizde açın, işiniz bitince kapatın (false).
SESLI_KOMUT_TANI=false
# Kuyrukta en fazla kaç şarkı olabilir.
MAX_QUEUE_SIZE=1000
# true: /play şarkı adıyla kullanılınca ilk 5 sonuç listelenir, seçtiğiniz çalar.
# false: liste gösterilmez, ilk sonuç doğrudan çalar. (Bağlantı ve çalma listeleri her zaman doğrudan çalar.)
PLAY_SHOW_CHOICES=true
# Mesaj kutularının rengi (6 haneli renk kodu, başına # KOYMAYIN).
EMBED_COLOR=5865F2
# Konsol ayrıntısı: debug, info, warn, error.
LOG_LEVEL=info

# --- Bot sahibi (isteğe bağlı) ----------------------------------------
# /servers komutunu yalnızca bot sahibi kullanabilir. Boşsa sahip Discord Developer Portal'dan
# kendiliğinden bulunur (uygulama bir takımdaysa takım sahibi ve Admin üyeleri).
# Doldurursanız YALNIZCA buradaki kişiler sahip sayılır. Birden çok kimliği virgülle ayırın:
# BOT_OWNER_IDS=123456789012345678,234567890123456789
BOT_OWNER_IDS=

# --- Görünüm: /help altındaki bağlantılar (isteğe bağlı) ---------------
# Boş bırakılan bağlantı /help'te hiç gösterilmez. Adresler https:// ile başlamalı.
# Destek sunucunuzun Discord davet bağlantısı (ör. https://discord.com/invite/abc123).
BRAND_SUPPORT_URL=
# Botu yapanın adı ("By <ad>" olarak görünür).
BRAND_AUTHOR_NAME=
# Yapanın bağlantısı: web sitesi ya da sosyal medya profili. Ad boşsa gösterilmez.
BRAND_AUTHOR_URL=

# --- Web paneli (isteğe bağlı) ----------------------------------------
# true: bot açılınca tarayıcıdan yönetilebilen panel de açılır. false: panel hiç başlamaz.
PANEL_ENABLED=true
# Developer Portal > uygulamanız > OAuth2 > "Client Secret" (Reset Secret ile alınır).
# Boşsa panel açılmaz, bot normal çalışır. KİMSEYLE paylaşmayın.
DISCORD_CLIENT_SECRET=
# Oturum çerezlerini imzalayan gizli anahtar: en az 32 karakterlik rastgele bir metin.
# Boşsa bot her açılışta geçici bir anahtar üretir (yeniden başlatınca herkes çıkış yapmış olur).
PANEL_SESSION_SECRET=
# Panelin dinlediği adres ve port. 127.0.0.1 = yalnızca bu bilgisayar.
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
# Tarayıcıda açtığınız adres. Developer Portal'daki Redirect adresi bunun sonuna
# /auth/callback eklenmiş hali olmalı: http://127.0.0.1:3000/auth/callback
PANEL_PUBLIC_URL=http://127.0.0.1:3000
# Panel bir ters proxy (ör. Caddy, nginx) arkasındaysa true yapın. Aksi halde false kalsın.
PANEL_TRUST_PROXY=false
