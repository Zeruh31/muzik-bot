# Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Lavalink runtime files
lavalink/*.jar
lavalink/*.indiriliyor
lavalink/plugins/
lavalink/logs/

# YouTube OAuth token files (if ever stored outside .env)
*.token
youtube-token*.txt
oauth-token*.json

# Files the bot writes at runtime: per-server settings (DJ role), status for the desktop app,
# counters; see src/bot/serverSettings.js, durumDosyasi.js, istatistik.js
data/

# Desktop app build output and dependencies (also in desktop/.gitignore)
desktop/dist/
desktop/node_modules/

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
